<?xml version="1.0" encoding="utf-8"?>
<!--
  목적: 플러그인 FlutterEmailSenderFileProvider 의 경로 설정을 메일 첨부 사본
        폴더(cache/mail/)로만 좁힌다. 플러그인 원래 설정은 외부 저장소 ·
        files · cache 전체를 연다.
  근거: 인용 - flutter_email_sender_method_channel 1.0.1 이
        @xml/shared_file_paths 라는 이름의 리소스로 경로를 정한다. 앱 리소스는
        같은 이름의 라이브러리 리소스를 덮는다.
        첨부 사본 위치는 MeasurementRepository.mailAttachmentCopy() 가 정한다
        (getTemporaryDirectory() = Context.getCacheDir(), 그 아래 mail/).
        그 폴더 이름이 바뀌면 여기 path 도 같이 바꿔야 한다.
-->
<paths>
    <cache-path name="mail" path="mail/" />
</paths>
